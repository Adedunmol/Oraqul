{
  "name": "@oraqul/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:reviewer": "nest build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/scripts/seed-reviewer.js",
    "db:backfill-thread-names": "nest build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/scripts/backfill-thread-names.js",
    "error-sample": "nest build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/scripts/error-sample.js",
    "cost-report": "nest build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/scripts/cost-report.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@getbrevo/brevo": "^6.1.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@oraqul/engine": "workspace:*",
    "@oraqul/packs": "workspace:*",
    "@oraqul/schema": "workspace:*",
    "ai": "^7.0.143",
    "cookie-parser": "^1.4.7",
    "docx": "9.5.1",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.0",
    "mammoth": "^1.13.0",
    "pdfkit": "0.17.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
