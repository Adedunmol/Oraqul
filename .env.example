# API
DATABASE_URL=postgres://oraqul:oraqul@localhost:5433/oraqul
SESSION_SECRET=change-me-to-at-least-32-characters-long
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PORT=4000
# Parent domain for the session cookie in deployment, for example .example.com. Empty locally.
COOKIE_DOMAIN=
# Reverse proxies in front of the API (0 = none). Login rate limits use the client address.
TRUST_PROXY_HOPS=0

# Sign in. Google needs both values; an empty BREVO_API_KEY prints codes to the API console.
# With a Brevo key, EMAIL_FROM must be a sender verified in Brevo or no email arrives.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BREVO_API_KEY=
EMAIL_FROM=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Qloo (what is verified: docs/backend/qloo.md)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=30000
QLOO_CALL_BUDGET=60
# demo serves hand-written stand-in data and needs no key; live calls Qloo
QLOO_MODE=demo

# LLM (an empty OPENAI_API_KEY runs the scripted planner)
AGENT_MAX_STEPS=12
OPENAI_API_KEY=
OPENAI_MODEL=
