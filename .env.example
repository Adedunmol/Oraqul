# API
DATABASE_URL=postgres://oraqul:oraqul@localhost:5433/oraqul
SESSION_SECRET=change-me-to-at-least-32-characters-long
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PORT=4000
# Parent domain for the session cookie in deployment, for example .example.com. Empty locally.
COOKIE_DOMAIN=
# Reverse proxies in front of the API (0 = none). Login rate limits use the client address.
TRUST_PROXY_HOPS=0

# Sign in. Google needs both values; an empty BREVO_API_KEY prints codes to the API console.
# With a Brevo key, EMAIL_FROM must be a sender verified in Brevo or no email arrives.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BREVO_API_KEY=
EMAIL_FROM=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Qloo (what is verified: docs/backend/qloo.md)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=30000
QLOO_CALL_BUDGET=80
# demo serves hand-written stand-in data and needs no key; live calls Qloo
QLOO_MODE=demo
# The commit the server was built from (saved on every plan). Leave empty in development.
CODE_VERSION=

AGENT_MAX_STEPS=12

# The Guide's help bot (docs/backend/llm.md). Its own free Gemini key; empty turns the bot off.
# Limits: questions per visitor per hour, and questions for everyone per day.
GUIDE_BOT_API_KEY=
GUIDE_BOT_MODEL=gemini-3.5-flash-lite
GUIDE_BOT_HOURLY_LIMIT=12
GUIDE_BOT_DAILY_CAP=400

# Language model (docs/backend/llm.md). An empty LLM_API_KEY runs the scripted router.
# LLM_PROVIDER: openai, google, or openai-compatible (with LLM_BASE_URL, e.g. OpenRouter or Ollama)
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Optional: a different model for the router than for the category agents
LLM_ROUTER_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=90000
# Optional: write plans and answers with a stronger model, even from another provider. Empty values
# use the settings above. A provider's base url is not shared with a different provider, and a
# writer on another provider needs its own key (the main key is never sent to it).
#
# Recommended (docs/backend/llm.md): the writer on OpenAI, the short steps unchanged.
#   LLM_WRITER_PROVIDER=openai
#   LLM_WRITER_API_KEY=<an OpenAI key>
#   LLM_WRITER_MODEL=gpt-5.4-mini    (about $0.04 a plan; gpt-6.1-sol is about $0.50 and goes deeper)
LLM_WRITER_PROVIDER=
LLM_WRITER_API_KEY=
LLM_WRITER_MODEL=
LLM_WRITER_BASE_URL=
LLM_WRITER_TIMEOUT_MS=180000
# How hard an OpenAI reasoning model thinks before writing: minimal, low, medium or high. Lower is
# faster and cheaper. At the default a plan takes about 2 minutes on gpt-5.4-mini and 5 to 7 on gpt-6.1-sol.
LLM_WRITER_REASONING=low
# Web search for release timing, rival releases and who distributes films (OpenAI and Google only).
# On OpenAI it costs about a cent a search. Turn it off with a writer that has no search quota.
LLM_WEB_SEARCH=on
