{
  "name": "@oraqul/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qloo:smoke": "tsx --env-file=../../.env scripts/qloo-smoke.ts",
    "qloo:cross-domain": "tsx --env-file=../../.env scripts/qloo-cross-domain.ts",
    "qloo:proxy-bundle": "tsx --env-file=../../.env scripts/qloo-proxy-bundle.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@oraqul/schema": "workspace:*",
    "zod": "^4.6.7"
  }
}
