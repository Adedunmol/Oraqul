{
  "name": "@oraqul/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oraqul/engine": "workspace:*",
    "@oraqul/schema": "workspace:*",
    "zod": "^4.6.7"
  },
  "bin": {
    "oraqul-mcp": "./dist/stdio.js"
  }
}
